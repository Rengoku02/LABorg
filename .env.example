# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=labstock.example.org
# The permanent public URL (plan §2 "Hostname"): email links and QR labels are built from it.
LABSTOCK_SITE_URL=https://labstock.example.org
LABSTOCK_TIME_ZONE=America/New_York

# --- Database (compose.yaml builds DATABASE_URL from these) ---
POSTGRES_DB=labstock
POSTGRES_USER=labstock
POSTGRES_PASSWORD=change-me

# --- Email (django-anymail; plan §2 "Email") ---
# Postmark example; for Amazon SES use anymail.backends.amazon_ses.EmailBackend, etc.
LABSTOCK_MAIL_BACKEND=anymail.backends.postmark.EmailBackend
LABSTOCK_MAIL_API_KEY=
LABSTOCK_MAIL_API_KEY_OPTION=server_token
LABSTOCK_ALERTS_FROM=LabStock <alerts@labstock.example.org>
LABSTOCK_NEWS_FROM=LabStock <news@labstock.example.org>

# --- Quartzy (read-only mirror) ---
# Profile Settings → Access Tokens in Quartzy. A Lab Member token is enough for reads.
QUARTZY_ACCESS_TOKEN=
# Pin these from `python -m scripts.quartzy_probe measure` (Phase 0):
QUARTZY_PAGE_BASE=1
QUARTZY_NEW_ITEMS_AT=unknown
QUARTZY_MONEY_UNIT=auto
# The lab's own Quartzy lab ids, comma-separated (`quartzy_probe measure` prints them). Any
# other lab the token sees, e.g. a collaborator's, is recorded but not synced, and the Phase 0
# export leaves it out. Empty: only a lone first lab is mirrored, and the export refuses to
# choose among several. The sync applies it when a lab is first found; later, use the admin.
QUARTZY_LAB_IDS=

# --- Monitoring: external dead-man's switch (healthchecks.io or self-hosted) ---
LABSTOCK_HEARTBEAT_WORKER_URL=
LABSTOCK_HEARTBEAT_SYNC_URL=
# scripts/backup.sh pings this after each backup.
LABSTOCK_HEARTBEAT_BACKUP_URL=
# Optional error tracking (Sentry or self-hosted GlitchTip). Events are scrubbed of tokens,
# searches and personal data before they are sent. Leave empty to turn it off.
LABSTOCK_SENTRY_DSN=

# --- Caddy ---
LABSTOCK_DOMAIN=labstock.example.org
